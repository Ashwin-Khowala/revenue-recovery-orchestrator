# ==============================================================================
# REVENUE RECOVERY ORCHESTRATOR — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Azure OpenAI (Reasoning & Structured Intervention Candidate Generation)
# ------------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. Razorpay Test Mode & Webhooks
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ------------------------------------------------------------------------------
# 3. Supabase Cloud (PostgreSQL Database & Event Store)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Connection string for LangGraph PostgresSaver checkpointer
SUPABASE_DB_URI=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 4. WhatsApp Business Cloud API (Meta Sandbox)
# ------------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token
WHATSAPP_RECIPIENT_TEST_NUMBER=+919876543210

# ------------------------------------------------------------------------------
# 5. Email Recovery Channel (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
RECOVERY_FROM_EMAIL=recovery@yourdomain.com

# ------------------------------------------------------------------------------
# 6. Tracing & Auditing (Langfuse Cloud)
# ------------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ------------------------------------------------------------------------------
# 7. Voice Channel (ElevenLabs Hinglish TTS — Optional / Stretch Goal)
# ------------------------------------------------------------------------------
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# ------------------------------------------------------------------------------
# 8. Google Gemini (Fallback LLM + DeepEval Judge Model)
# ------------------------------------------------------------------------------
# Free-tier API key from https://aistudio.google.com/app/apikey
# Used by: root_cause_classifier fallback, deepeval judge model
GEMINI_API_KEY=your_gemini_api_key

# ------------------------------------------------------------------------------
# 9. DeepEval / Confident AI Evaluation Platform
# ------------------------------------------------------------------------------
# Get your key from: https://app.confident-ai.com → Settings → API Keys
CONFIDENT_API_KEY=your_confident_ai_api_key

# Judge model for LLM-as-judge metrics (GEval, Hallucination).
# Default: gemini-2.5-flash-lite (500 free-tier req/day — much higher quota).
# Switch to gemini-3.6-flash for stronger reasoning (20 free-tier req/day).
DEEPEVAL_JUDGE_MODEL=gemini-2.5-flash-lite

# ------------------------------------------------------------------------------
# 10. Server & Orchestrator Config
# ------------------------------------------------------------------------------
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
